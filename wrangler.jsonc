// Cloudflare Workers deployment (secondary target; Vercel is primary and ignores this file).
// Build with `pnpm cf:build`, deploy with `pnpm cf:deploy`. See README "Deploying to Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitcoinmining",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // No production workers.dev copy of the site (it would duplicate www); PR Previews get workers.dev URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Workers Cache stays off: its cache key ignores the hostname, so the apex's cached 308 → www
  // could be served to www itself (a redirect loop). Static assets are cached via public/_headers.
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image optimization (the header logo)
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Worker Previews (Workers Builds runs `npx wrangler preview` on non-main branches). Previews don't
  // inherit top-level bindings, so the ones the code reads from env are repeated here.
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  }
}
