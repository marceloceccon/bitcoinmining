# Cloudflare Workers static assets. They're served before the Worker runs, so next.config.js headers()
# never reach them; Vercel ignores this file (it serves it as a plain static file).

# Content-hashed build output never changes under the same URL (Workers' default is max-age=0).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/openapi.json
  X-Robots-Tag: noindex

# llms.txt has non-ASCII characters; Workers serves it as text/plain with no charset.
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Icons and the schema screenshot keep their URLs between builds, so a day rather than forever.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-96x96.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=86400
/web-app-manifest-512x512.png
  Cache-Control: public, max-age=86400
/screenshot.png
  Cache-Control: public, max-age=86400
